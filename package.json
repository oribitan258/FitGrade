{
  "name": "fitgrade",
  "version": "0.0.0",
  "private": true,
  "description": "FitGrade — PE grading & attendance system (Hebrew/RTL)",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules",
    "audit:logic": "claude --agent logic-qa",
    "audit:security": "claude --agent security-qa",
    "audit:ui": "claude --agent ui-qa",
    "audit:db": "claude --agent db-qa",
    "audit:all": "pnpm audit:security && pnpm audit:logic && pnpm audit:db && pnpm audit:ui",
    "fix:bugs": "claude --agent bug-fixer"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "framer-motion": "^12.35.0"
  }
}
