{
  "name": "fitgrade",
  "version": "0.0.0",
  "private": true,
  "description": "FitGrade — PE grading & attendance system (Hebrew/RTL)",
  "scripts": {
    "build": "turbo build",
    "build:prod": "turbo build --filter=@fitgrade/web --filter=@fitgrade/api",
    "dev": "turbo dev",
    "start:web": "pnpm --filter=@fitgrade/web start",
    "start:api": "pnpm --filter=@fitgrade/api start",
    "preview": "turbo start --parallel --filter=@fitgrade/web --filter=@fitgrade/api",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules",
    "audit:logic": "claude --agent logic-qa",
    "audit:security": "claude --agent security-qa",
    "audit:ui": "claude --agent ui-qa",
    "audit:db": "claude --agent db-qa",
    "audit:all": "pnpm audit:security && pnpm audit:logic && pnpm audit:db && pnpm audit:ui",
    "fix:bugs": "claude --agent bug-fixer"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.49.0",
    "@types/node": "^25.6.0",
    "@xstate/test": "^0.5.0",
    "turbo": "^2.9.14",
    "xstate": "^4.38.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "framer-motion": "^12.35.0"
  },
  "pnpm": {
    "overrides": {
      "handlebars": ">=4.7.8",
      "multer": ">=2.1.1"
    }
  }
}
