{
  "name": "@fitgrade/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "FitGrade mobile field app — Expo SDK 51 (React Native), teacher-only",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export",
    "eas:build:preview": "eas build --profile preview --platform android",
    "eas:build:prod": "eas build --profile production --platform android",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "jest --watchAll=false",
    "test:watch": "jest --watchAll"
  },
  "dependencies": {
    "@fitgrade/types": "workspace:*",
    "@react-native-community/netinfo": "^11.3.0",
    "@react-navigation/native": "^6.1.18",
    "@tanstack/react-query": "^5.51.1",
    "expo": "~51.0.28",
    "expo-constants": "~16.0.2",
    "expo-haptics": "~13.0.1",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.23",
    "expo-secure-store": "^55.0.13",
    "expo-splash-screen": "~0.27.5",
    "expo-status-bar": "~1.12.1",
    "expo-web-browser": "~13.0.3",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.17.1",
    "react-native-mmkv": "^3.0.2",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^12.5.1",
    "@types/node": "^20.14.0",
    "@types/react": "~18.2.79",
    "babel-preset-expo": "~11.0.14",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.1.2",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@fitgrade/.*)"
    ]
  }
}
