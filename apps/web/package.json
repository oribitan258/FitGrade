{
  "name": "@fitgrade/web",
  "version": "0.0.0",
  "private": true,
  "description": "FitGrade web dashboard — Next.js 14 (App Router), Tailwind CSS, shadcn/ui",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@fitgrade/types": "workspace:*",
    "@hookform/resolvers": "^3.6.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.69",
    "@types/react-signature-canvas": "^1.0.7",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.400.0",
    "next": "^14.2.4",
    "react": "^18.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "react-joyride": "^3.1.0",
    "react-signature-canvas": "1.1.0-alpha.2",
    "recharts": "^2.12.7",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.3.0",
    "vaul": "^1.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@xstate/test": "^0.5.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.4",
    "fast-check": "^4.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.2.2",
    "typescript": "^5.5.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/.next/"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        { "tsconfig": "<rootDir>/tsconfig.test.json" }
      ]
    },
    "coverageThreshold": {
      "./components/tour/use-tour-machine.ts": { "branches": 90, "statements": 90, "functions": 90, "lines": 90 },
      "./components/tour/use-signal-page-ready.ts": { "branches": 90, "statements": 90, "functions": 90, "lines": 90 },
      "./components/tour/NullBeacon.tsx": { "branches": 90, "statements": 90, "functions": 90, "lines": 90 },
      "./lib/tour-fetcher.ts": { "branches": 90, "statements": 90, "functions": 90, "lines": 90 },
      "./lib/tour-mock-handlers.ts": { "branches": 90, "statements": 90, "functions": 90, "lines": 90 },
      "./lib/tour-steps.ts": { "branches": 90, "statements": 90, "functions": 90, "lines": 90 }
    }
  }
}
