# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/fitgrade"

# ─── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ─── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── App ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
WEB_URL=http://localhost:3000

# ─── Dev-only bypass (SEC-010) ────────────────────────────────
# Set to 'true' ONLY in local dev. Leave unset in staging/production.
# POST /api/auth/dev-login issues a teacher JWT without Google OAuth.
# The endpoint is blocked unless this is 'true' AND NODE_ENV != 'production'.
ENABLE_DEV_LOGIN=true

# ─── AI Copilot ───────────────────────────────────────────────
GOOGLE_AI_API_KEY=
