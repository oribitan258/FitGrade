generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Semester {
  A
  B
}

enum FitnessInputType {
  TIME
  REPS
  PASS_FAIL
  GENERAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ClassGenderType {
  BOYS
  GIRLS
  MIXED
}

enum AuditAction {
  GRADE_OVERRIDE
  GRADE_ENTRY
  RESULT_EDIT
  ATTENDANCE_CHANGE
  STUDENT_ENROLLED
  STUDENT_REMOVED
  TALMIDAUT_ENTRY
}

enum TestCategory {
  ENDURANCE      // סיבולת  — ריצות, מבחן ביפ
  STRENGTH       // כוח     — כפיפות בטן, מתח, שכיבות סמיכה, תלייה, כדור כוח
  SPEED_AGILITY  // מהירות וזריזות — ריצת 60מ, הלוך ושוב 4×10, קפיצה לרוחק
  FLEXIBILITY    // גמישות  — כפיפת גו לפנים
}

// ─────────────────────────────────────────────
// TEACHER (Google OAuth)
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  school    String?  // Optional school / institution name
  avatarUrl String?
  googleId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Global grading policy defaults (applied when a class has no per-class override) ──
  /// Default percentage of the final grade derived from fitness tests (0–100). Must sum to 100 with defaultConductWeight.
  defaultFitnessWeight  Int @default(55)
  /// Default percentage of the final grade derived from Talmida'ut conduct (0–100).
  defaultConductWeight  Int @default(45)

  // ── Report & grading policy settings ──────────────────────────────────
  /// Minimum score considered passing (0–100). Replaces the hardcoded 60.
  passingGrade     Int     @default(60)
  /// Teacher's display name shown in greetings and on PDF report headers. Null = use Google name.
  teacherName      String?
  /// School name as it should appear on PDF exports and report headers.
  schoolName       String?
  /// URL to the school logo image used in PDF export headers.
  schoolLogoUrl    String?
  /// Teacher's drawn signature (Base64 PNG Data URL) for PDF reports.
  teacherSignature String?

  // ── Onboarding state ──────────────────────────────────────────────────
  /// false until the teacher completes the welcome tour + setup form.
  /// All teacher routes redirect to /onboarding while this is false.
  isOnboardingComplete Boolean @default(false)

  // ── Default test preferences (selected during onboarding) ─────────────
  /// IDs of FitnessTestType records the teacher prefers for MALE/BOYS classes.
  /// Empty array = use system defaults. Validated against FitnessTestType at write-time.
  defaultMaleTestIds   String[] @default([])
  /// IDs of FitnessTestType records the teacher prefers for FEMALE/GIRLS classes.
  defaultFemaleTestIds String[] @default([])

  classes         Class[]
  auditLogs       AuditLog[]
  events          Event[]
  scheduleEntries ScheduleEntry[]

  @@map("users")
}

// ─────────────────────────────────────────────
// CLASS
// ─────────────────────────────────────────────

model Class {
  id                String    @id @default(cuid())
  name              String    // e.g., "כיתה י' 1"
  academicYear      String    // e.g., "2024-2025"
  joinCode          String    @unique // 6-char alphanumeric
  joinCodeExpiresAt DateTime? // null = never expires
  deletedAt         DateTime? // null = active; non-null = soft-deleted
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  /// Composition of the class: BOYS-only, GIRLS-only, or MIXED. Drives gender-split norm lookups.
  genderType ClassGenderType @default(MIXED)

  /// School grade level 1–12. Used to render "recommended" badges in the test picker.
  /// null = legacy class created before this field was added.
  gradeLevel Int?

  // ── Per-class final-grade weight overrides ───────────────────────────
  // null = inherit from the teacher's global defaultFitnessWeight / defaultConductWeight.
  // When set, testWeight + talmidautWeight must sum to 100.
  testWeight        Int? // null = use teacher's global default
  talmidautWeight   Int? // null = use teacher's global default

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  enrollments       ClassEnrollment[]
  testSessions      TestSession[]
  attendanceRecords AttendanceRecord[]
  talmidautRecords  TalmidautRecord[]
  finalGrades       StudentFinalGrade[]
  scheduleEntries   ScheduleEntry[]

  @@index([teacherId])
  @@map("classes")
}

// ─────────────────────────────────────────────
// STUDENT (Code + Password auth)
// ─────────────────────────────────────────────

model Student {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  dateOfBirth  DateTime? // Optional — imported students may lack DOB; required for age-based norm lookup
  gender       Gender
  nationalId   String?   @unique // ת"ז — 9-digit Israeli national ID (Luhn-validated at app layer)
  studentCode  String    // Internal code, unique per class (enforced in service layer)
  passwordHash String?   // bcrypt hash — null for passwordless (national ID) login
  deletedAt    DateTime? // null = active; non-null = soft-deleted
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enrollments       ClassEnrollment[]
  testResults       TestResult[]
  attendanceRecords AttendanceRecord[]
  talmidautRecords  TalmidautRecord[]
  finalGrades       StudentFinalGrade[]

  @@map("students")
}

// ─────────────────────────────────────────────
// CLASS ↔ STUDENT (many-to-many)
// ─────────────────────────────────────────────

model ClassEnrollment {
  id          String   @id @default(cuid())
  enrolledAt  DateTime @default(now())
  // Denormalized from Student to enable a DB-level unique constraint on (classId, studentCode).
  // This guarantees no two students share the same code within a class, even under concurrent inserts.
  studentCode String

  classId String
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Back-reference: cascade-deletes StudentFinalGrade when this enrollment is removed.
  finalGrade StudentFinalGrade?

  @@unique([classId, studentId])
  @@unique([classId, studentCode])
  @@index([classId])
  @@index([studentId])
  @@map("class_enrollments")
}

// ─────────────────────────────────────────────
// FITNESS TEST CATALOG
// ─────────────────────────────────────────────

model FitnessTestType {
  id            String           @id @default(cuid())
  nameHe        String           // Hebrew name, e.g., "ריצת 100 מטר"
  descriptionHe String?          // Optional Hebrew description
  inputType     FitnessInputType
  unit          String?          // e.g., "שניות", "מטר"
  isGlobal      Boolean          @default(true) // true = system-seeded Ministry data

  // higherIsBetter: true for distance/reps tests (jumps, throws);
  // false for TIME tests (sprints, runs) where a lower value = better performance.
  // The GradingService uses this to correctly interpret NormTable minValue/maxValue bands.
  higherIsBetter Boolean         @default(false)

  /// Logical grouping for the UI test picker (category tabs + icons).
  category TestCategory @default(ENDURANCE)

  /// Recommended minimum school grade (1–12). Display metadata only — never used to filter tests.
  minGrade Int?

  /// Recommended maximum school grade (1–12). Display metadata only — never used to filter tests.
  maxGrade Int?

  createdAt DateTime @default(now())

  normTables NormTable[]
  sessions   TestSession[]

  @@map("fitness_test_types")
}

// ─────────────────────────────────────────────
// NORM TABLES (System-seeded, read-only)
// Each row maps a raw-value band → score for a specific gender + school grade level.
// Grade levels correspond to Israeli school grades 1–12.
// ─────────────────────────────────────────────

model NormTable {
  id         String  @id @default(cuid())
  gender     Gender
  gradeLevel Int     // School grade level 1–12 (matches Class.gradeLevel)
  minValue   Decimal // Raw value lower bound (inclusive)
  maxValue   Decimal // Raw value upper bound (exclusive)
  score      Int     // Grade awarded: 1–100

  testTypeId String
  testType   FitnessTestType @relation(fields: [testTypeId], references: [id], onDelete: Cascade)

  @@index([testTypeId, gender, gradeLevel])
  @@map("norm_tables")
}

// ─────────────────────────────────────────────
// TEST SESSION (One grading session per class)
// ─────────────────────────────────────────────

model TestSession {
  id          String    @id @default(cuid())
  semester    Semester  @default(A) // Semester this session belongs to (A = first, B = second)
  conductedAt DateTime  @default(now())
  notes       String?
  isStopwatch Boolean   @default(false) // true = stopwatch mode was used
  startedAt   DateTime? // Server-side stopwatch start time
  completedAt DateTime? // Set when the session is explicitly closed

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  testTypeId String
  testType   FitnessTestType @relation(fields: [testTypeId], references: [id], onDelete: Restrict)

  results           TestResult[]
  attendanceRecords AttendanceRecord[]

  @@index([classId])
  @@index([classId, testTypeId])
  @@index([testTypeId])
  @@map("test_sessions")
}

// ─────────────────────────────────────────────
// TEST RESULT (One row per student per session)
// ─────────────────────────────────────────────

model TestResult {
  id              String   @id @default(cuid())
  rawValue        Decimal? // null = not yet entered
  calculatedGrade Int?     // 1–100, set by GradingService
  gradeOverride   Int?     // 1–100, set manually by teacher
  overrideReason  String?  // Required when gradeOverride is set
  recordedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessionId String
  session   TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("test_results")
}

// ─────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────

model AttendanceRecord {
  id                 String           @id @default(cuid())
  date               DateTime
  status             AttendanceStatus @default(PRESENT)
  semester           Semester         @default(A) // Which semester this record belongs to
  notes              String?
  exemptionReason    String?          // Free-text reason; populated when status = EXCUSED
  exemptionExpiresAt DateTime?        // null = no automatic expiry
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  classId String
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  sessionId String?      // Optional: link to the test session this attendance was taken for
  session   TestSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([classId, studentId, date])
  @@index([classId, date])
  @@index([classId, semester])
  @@index([studentId])
  @@map("attendance_records")
}

// ─────────────────────────────────────────────
// TALMIDA'UT (תלמידאות) — Behaviour Assessment
// Tracks the three components of Talmida'ut per student per class.
// Can be recorded multiple times (e.g., monthly) to build a trend.
// The average across all records for the semester forms the Talmida'ut score.
// ─────────────────────────────────────────────

model TalmidautRecord {
  id String @id @default(cuid())

  // Three sub-dimensions, each scored 0–100:
  //   participation: active involvement in lessons and drills
  //   uniform:       arriving dressed appropriately for PE
  //   behavior:      conduct, respect for peers and teacher
  participation Int // 0–100
  uniform       Int // 0–100
  behavior      Int // 0–100

  notes      String?
  /// Calendar date of the lesson this record belongs to (date-only, no time component).
  /// Enforced unique per (classId, studentId, lessonDate) to prevent duplicate entries for the same lesson.
  lessonDate DateTime @default(now()) @db.Date
  recordedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  classId String
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId, lessonDate])
  @@index([classId, studentId])
  @@index([studentId])
  @@map("talmidaut_records")
}

// ─────────────────────────────────────────────
// STUDENT FINAL GRADE (ציון סופי מומלץ)
// Stores the recommended end-of-semester grade for one student in one class.
// Recomputed whenever test results or Talmida'ut records change.
// Formula: (fitnessAvg × class.testWeight + talmidautAvg × class.talmidautWeight) / 100
// ─────────────────────────────────────────────

model StudentFinalGrade {
  id String @id @default(cuid())

  // Component averages (0–100)
  fitnessAvg   Int // Weighted avg of all test calculatedGrade/gradeOverride values
  talmidautAvg Int // Average of all TalmidautRecord composite scores in this class

  // The recommended grade (0–100) computed from the two components
  recommendedGrade Int

  // Teacher overrides — set via the Reports Center
  teacherFinalGrade Int?    // null = use recommendedGrade as-is
  verbalComment     String? // Ministry-standard or custom verbal comment

  calculatedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  classId String
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Compound FK to ClassEnrollment: cascade-deletes this grade when a student is removed from the class.
  // Resolves the gap where StudentFinalGrade persisted after ClassEnrollment deletion.
  enrollment ClassEnrollment @relation(fields: [classId, studentId], references: [classId, studentId], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([classId])
  @@map("student_final_grades")
}

// ─────────────────────────────────────────────
// EVENT (School sports calendar events)
// ─────────────────────────────────────────────

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  eventDate   DateTime
  location    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, eventDate])
  @@map("events")
}

// ─────────────────────────────────────────────
// SCHEDULE ENTRY (Teacher weekly timetable)
// One row per class assigned to a day+period slot.
// dayOfWeek: 0=Sunday, 1=Monday … 4=Thursday (Israeli school week).
// period: 0-based index mapping to PERIOD_START_TIMES constant.
// startTime: "HH:MM" string — denormalised from PERIODS for server-side status calc.
// ─────────────────────────────────────────────

model ScheduleEntry {
  id        String   @id @default(cuid())
  dayOfWeek Int      // 0–6 (0 = Sunday)
  period    Int      // 0-based period index
  startTime String   // "HH:MM" — denormalised for fast status computation
  semester  Semester @default(A) // Which semester this timetable belongs to

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, dayOfWeek, period, semester])
  @@index([teacherId, dayOfWeek, semester])
  @@map("schedule_entries")
}

// ─────────────────────────────────────────────
// AUDIT LOG (Immutable — append-only)
// ─────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String      // "TestResult" | "AttendanceRecord" | "ClassEnrollment" | "TalmidautRecord"
  entityId   String      // ID of the affected record
  oldValue   Json?       // JSON snapshot before change
  newValue   Json?       // JSON snapshot after change
  createdAt  DateTime    @default(now())

  actorId String // userId (teacher) who performed the action
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ─── Auth: revoked refresh tokens ────────────────────────────────────────────
// Persists the jti (JWT ID) of every refresh token that was explicitly revoked
// via logout. Replaces the previous in-memory Map so revocations survive
// API restarts and work correctly across multiple instances. (SEC-002)
model RevokedToken {
  jti       String   @id             // unique by definition — JWT ID
  expiresAt DateTime                  // mirrors the token's exp claim
  revokedAt DateTime @default(now())

  // For the hourly cleanup sweep: delete all rows where expiresAt < now()
  @@index([expiresAt])
  @@map("revoked_tokens")
}

// ─── RUM (Real User Monitoring) ──────────────────────────────────────────────
// Stores web-vitals observations beaconed from the production web app.
// No foreign keys — rows are append-only, no auth context required.
model RumMetric {
  id             String   @id @default(cuid())
  metricName     String   // INP | LCP | CLS | FCP | TTFB
  value          Float
  rating         String   // good | needs-improvement | poor
  navigationType String   // navigate | reload | back-forward | back-forward-cache | prerender
  pageUrl        String
  recordedAt     DateTime @default(now())

  @@index([metricName, recordedAt])
  @@index([recordedAt])
  @@map("rum_metrics")
}
