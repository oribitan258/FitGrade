# pnpm config — hoisted node_modules layout.
#
# Required for the Expo mobile app (apps/mobile/) to build via EAS:
# EAS Build invokes expo's bundled CLI binary by its absolute path inside
# .pnpm/<deduplicated>/node_modules/expo/bin/cli — which fails to resolve
# its own dependencies in pnpm's default symlinked layout.
#
# Setting node-linker=hoisted makes pnpm install node_modules in a flat
# layout (like npm), so binaries can resolve their dependencies normally.
# This is the documented fix in https://docs.expo.dev/guides/monorepos/.
#
# Web (Vercel) and API (Render) builds are unaffected — both happen on
# remote infrastructure with their own install steps, and locally hoisted
# layout is strictly a superset of what nested layout exposes.
node-linker=hoisted
